{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "epub-reader",
  "version": "0.1.0",
  "identifier": "com.dev.epub-reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "epub-reader",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "font-src": "'self' blob: data:",
        "img-src": "'self' blob: data: http://epub.localhost epub://localhost",
        "connect-src": "'self' blob: data: ipc://localhost http://ipc.localhost http://epub.localhost epub://localhost",
        "frame-src": "blob:",
        "media-src": "blob: data:",
        "object-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "open",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  }
}
